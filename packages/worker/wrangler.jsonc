{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "austria-property-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
